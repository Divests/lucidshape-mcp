#pragma NOPP
void main(){
object n;
object progress=JSONStore(@@PROGRESS@@,0,1);progress<<"entered main";progress=n;
object app=getApplication();
object data;
if(@@IS_IES@@) data=IESData("MCP native photometry",@@SOURCE@@);
else {object group=ObjectVector("MCP input",());group.readFileIntoGroup(@@SOURCE@@,$,1);object found=group.getObjects("UVData");if(found.size()==1)data=found[0];}
progress=JSONStore(@@PROGRESS@@,0,1);progress<<"loaded input";progress=n;
if(!data || (@@REQUIRE_CD@@ && !data.isInCandela()) || (data.isInCandela() && data.angleType()>1) || data.isSpectral() || data.sizeW()!=1 || data.sizeT()!=1)return;
progress=JSONStore(@@PROGRESS@@,0,1);progress<<"validated input";progress=n;
double inputIsCandela=data.isInCandela(),inputAngleType=data.angleType();
double inputU,inputV;
double inputPeak=data.maxValue(inputU,inputV),inputFlux=data.integral();
object view=app.createUVDataModelView(data);
progress=JSONStore(@@PROGRESS@@,0,1);progress<<"created view";progress=n;
if(!view)return;
view.setWindowSize(@@WIDTH@@,@@HEIGHT@@);
object props=view.getProperties();
progress=JSONStore(@@PROGRESS@@,0,1);progress<<"read properties";progress=n;
props[9]=@@DISPLAY_QUANTITY@@;
view.setProperties(props);
props=view.getProperties();
progress=JSONStore(@@PROGRESS@@,0,1);progress<<"display quantity applied";progress=n;
props[7]=@@DISPLAY_MODE@@;props[10]=0;props[11]=0;props[12]=@@SCALE_MODE@@;props[16]=1;props[17]=1;props[19]=@@SHOW_CONTOURS@@;props[20]=1;
@@MODS@@
view.setProperties(props);
progress=JSONStore(@@PROGRESS@@,0,1);progress<<"applied properties";progress=n;
object bitmap=view.snapshotBitmap();
progress=JSONStore(@@PROGRESS@@,0,1);progress<<"captured bitmap";progress=n;
bitmap.saveBMPFile(@@PNG@@);
double w,h;view.getWindowSize(w,h);
object out=JSONStore(@@RECEIPT@@,0,1);
out<<(@@NONCE@@,1,"succeeded",view.nameOfClass(),(w,h),(inputPeak,inputU,inputV),inputFlux,view.getProperties(),inputIsCandela,inputAngleType,"completed");out=n;
}
