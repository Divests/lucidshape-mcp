// Fixed bounded native batch. Only derived snapshots, no Studio connection.
@@SCENE_SETUP@@
object app=getApplication();
object settings=();
app.getGlobalSettings(settings);
// Installed include/tasks/globalSettings.hdo: physical tolerances scale with CAD.
settings[20]=.01*@@SCALE@@;
settings[21]=.01*@@SCALE@@;
settings[22]=100*@@SCALE@@;
settings[24]=.01*@@SCALE@@;
settings[26]=.05*@@SCALE@@;
settings[27]=100*@@SCALE@@;
app.setGlobalSettings(settings);
app.resetSurfaceTriangles();
if(@@MODE@@==13) setGPUTraceDeviceID(0);

// Independently verify the native reader's normalization before tracing optics.
object calibration=LIDData("source flux calibration",(),0,360,720,(-90,90,-180,180),1,$);
object calSource=PointLight("calibration",AxisSystem("identity",$,(0,0,0),(0,0,1),(1,0,0)),RayFileEmitter("calibration","source.ray",0,air));
object calScene=ObjectVector("calibration",(calSource,SurfaceShape("calibration",InfinitySurface("",0),CandelaSensor("calibration",1,calibration))));
object calTrace=ForwardRayTrace("source flux calibration",0,1,1,calScene);
if(!calTrace.traceRays(@@COUNT@@,1,0,0,20,0,0,380,780,0,0,0,@@COUNT@@)) return;
double calibratedFlux=calibration.integral();
cout << "SOURCE_CALIBRATION " << calibratedFlux << endl;
if(abs(calibratedFlux-@@SOURCE_FLUX@@)>@@SOURCE_FLUX@@*.00002) {
    cout << "LUCIDSHAPE_MCP_FAILED: source flux calibration differs" << endl; return;
}
object geometry=scene;
object stats=();
object groupNames=@@GROUP_NAMES@@;
object groupSizes=@@GROUP_SIZES@@;
for(double group=0;group<@@GROUP_COUNT@@;group=group+1) {
    scene=ObjectVector("native batch",(geometry));
    @@BATCH_SOURCES@@
    object lid=LIDData("provisional GPU far field",(),0,@@GRID_U@@,@@GRID_V@@,@@SENSOR_BOUNDS@@,1,$);
    object axis=AxisSystem("configured far field",$,(0,0,0),@@SENSOR_Z@@,@@SENSOR_X@@);
    scene << SurfaceShape("far field",RotatedInfinitySurface("",0,axis),CandelaSensor("sensor",1,lid));
    double n=groupSizes[group]*@@COUNT@@;
    string filename; filename << groupNames[group] << ".lid";
    object trace=ForwardRayTrace("native GPU batch",0,256,1,scene);
    if(@@MODE@@==20) {
        // Constructor form generated by installed include/tasks/startSimulation.hdo.
        double processors=getNumberOfProcessors();
        if(processors>12) processors=12;
        trace=ForwardRayTrace("CPU control reference",0,256,1,1,processors,0,scene);
    }
    cout << "OPTICAL_GROUP_BEGIN " << group << " " << n << endl;
    if(!trace.traceRays(n,1,0,0,@@MODE@@,0,0,380,780,0,0,0,n)) {
        cout << "LUCIDSHAPE_MCP_FAILED: native batch failed" << endl; return;
    }
    object saved=Store(filename);
    saved << lid.cloneData(0);
    saved=null;
    double u0,u1,v0,v1,lo,hi;
    lid.range(u0,u1,v0,v1,lo,hi);
    stats << (group,n,lo,hi,lid.integral());
    cout << "OPTICAL_GROUP_END " << group << " " << lid.integral() << endl;
}
object out=JSONStore("engine-result.json",0,1);
out << (regions,geometryBounds,calibratedFlux,stats,@@MODE@@);
out=null;
cout << "LUCIDSHAPE_MCP_OK" << endl;
