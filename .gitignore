# This working directory also contains private engineering projects.
# Only explicitly listed source directories belong to the Git repository.
/*
!/.gitignore
!/.gitattributes
!/.editorconfig
!/pyproject.toml
!/MANIFEST.in
!/README.md
!/LICENSE*
!/docs/
!/lucidshape_mcp/
!/tests/
!/examples/
!/scripts/
!/.github/

# Local engineering data, build output, and archived experiment drivers.
/local-data/
/workspace/
# Only the shared maintenance scripts below belong in the source repository.
/scripts/*
!/scripts/check_repository.py
!/scripts/smoke_mcp.py
!/scripts/verify_distribution.py
!/scripts/bootstrap.py
!/scripts/verify_fresh_install.py
!/scripts/verify_harness_configs.py
!/scripts/validate_full_mcp.py
!/scripts/validate_optical_extensions.py

__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
build/
dist/
.DS_Store
Thumbs.db
*.log
*.local.*
.env
.env.*
*.pem
*.key
*.pfx
*.p12

# Native project data must never enter by accident.
*.[Cc][Aa][Tt][Pp][Aa][Rr][Tt]
*.[Cc][Aa][Tt][Pp][Rr][Oo][Dd][Uu][Cc][Tt]
*.[Ss][Tt][Ee][Pp]
*.[Ss][Tt][Pp]
*.[Ii][Gg][Ee][Ss]
*.[Ii][Gg][Ss]
*.[Ss][Tt][Ll]
*.[Rr][Aa][Yy]
*.[Ll][Uu][Ee]
*.[Ll][Uu][Gg]
*.[Ll][Ii][Dd]
*.[Ii][Ee][Ss]
*.exe
*.dll
*.pdb
*.pdf
*.docx
*.pptx
*.xlsx
*.zip
*.7z

